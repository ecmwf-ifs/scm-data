# Test: per-point multi-timestep filtering in the SCM plugin, append_output=1 mode
#
# Same setup as test_scm_plugin_timestep, but with append_output=1 so that
# each point produces a single file across the run.  Each point still has an
# explicit list of target timesteps, so the file must contain exactly
# size(timesteps) time records (no _step_XXXXX_ suffix in the filename).
#
# Config (plume-config-ifs-t159-timestep-test-append.json):
#   point 1  timesteps=[1, 3, 5]           -> 3 records
#   point 2  timesteps=[2, 4, 6]           -> 3 records
#   point 3  timesteps=[1, 2, 3]           -> 3 records
#   point 4  timesteps=[4, 5, 6]           -> 3 records
#   point 5  timesteps=[1, 2, 3, 4, 5, 6]  -> 6 records
#
# The driver is run for 6 steps.  Expected outcome:
#   each point has exactly one file:
#       scm_in_proc_00001_pt_<ID>.nc
#   with the expected number of time records, and NO legacy per-step files.

set -eux

srcdir=@CMAKE_CURRENT_SOURCE_DIR@
bindir=@CMAKE_CURRENT_BINARY_DIR@

input_data_dir=@TEST_DATA_DIR@/input_files_t159
exedir=@CMAKE_BINARY_DIR@/bin
configs_dir=@CMAKE_BINARY_DIR@/tests/plugin_configs

tmpdir_tests=@CMAKE_BINARY_DIR@/tests/tmpdir_scm_plugin_timestep_append

if [[ ! -e $tmpdir_tests ]]; then
    mkdir -p $tmpdir_tests
else
    echo "Directory $tmpdir_tests already exists. Cleaning output files.."
    rm -f ${tmpdir_tests}/scm_in_proc_00001_pt_*
fi

cd $tmpdir_tests

# Symlinks to input data (reuse t159 GRIB files)
[[ ! -e cld_grib   ]] && ln -s $input_data_dir/cld_grib_t159   cld_grib
[[ ! -e sfc_grib   ]] && ln -s $input_data_dir/sfc_grib_t159   sfc_grib
[[ ! -e spec_grib  ]] && ln -s $input_data_dir/spec_grib_t159  spec_grib
[[ ! -e namelist_1c ]] && ln -s $input_data_dir/namelist_1c_t159 namelist_1c

export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-""}:@CMAKE_BINARY_DIR@/lib
export PLUME_CONFIG_FILE=$configs_dir/plume-config-ifs-t159-timestep-test-append.json
export PLUME_SCM_PLUGIN_VERT_TABLES_TEST_NAMELIST=./namelist_1c

# Run the driver for 6 steps (steps 1 .. 6)
export SCM_PLUGIN_TESTER_N_STEPS=6
$exedir/scm_plugin_tester


# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

check_exists() {
    local f="$1"
    if [[ ! -f "$f" ]]; then
        echo "FAIL: expected output file not found: $f"
        exit 1
    fi
    echo "OK:   expected file present:  $f"
}

check_absent() {
    local f="$1"
    if [[ -f "$f" ]]; then
        echo "FAIL: unexpected output file found: $f"
        exit 1
    fi
    echo "OK:   file correctly absent:  $f"
}

# Verify record count on the unlimited "time" dimension of a NetCDF file.
# If ncdump is not available on the system, the check is skipped with a note.
check_record_count() {
    local f="$1"
    local expected="$2"

    if ! command -v ncdump >/dev/null 2>&1 ; then
        echo "SKIP: ncdump not available, cannot verify record count for $f"
        return 0
    fi

    local actual
    actual=$(ncdump -h "$f" | awk '/time = UNLIMITED/ {
        for (i=1;i<=NF;i++) if ($i ~ /\(/) { gsub(/[(]/, "", $i); print $i; exit }
    }')

    if [[ -z "$actual" ]]; then
        echo "FAIL: could not determine record count of $f"
        exit 1
    fi

    if [[ "$actual" -ne "$expected" ]]; then
        echo "FAIL: $f has $actual time records, expected $expected"
        exit 1
    fi
    echo "OK:   $f has $expected time records"
}

proc=00001

# Point definitions from plume-config-ifs-t159-timestep-test-append.json
# Format: "point_id:expected_records"
point_defs=(
    "1:3"
    "2:3"
    "3:3"
    "4:3"
    "5:6"
)

for pdef in "${point_defs[@]}"; do
    IFS=':' read -r pid expected <<< "$pdef"
    pid_5d=$(printf "%05d" "$pid")

    echo "Checking point ${pid} (expected records=${expected})"

    # Expect the single appended file to exist with the right number of records.
    f_append="scm_in_proc_${proc}_pt_${pid_5d}.nc"
    check_exists "$f_append"
    check_record_count "$f_append" "$expected"

    # None of the legacy per-step files should be produced in APPEND mode.
    for s in 1 2 3 4 5 6; do
        s_5d=$(printf "%05d" "$s")
        f_legacy="scm_in_proc_${proc}_pt_${pid_5d}_step_${s_5d}.nc"
        check_absent "$f_legacy"
    done
done

echo "All per-point multi-timestep-filter checks (append_output=1) passed."
