# Test: per-point timestep filtering in the SCM plugin
#
# Each point in the config carries a "timestep" value.  The plugin must write
# an output NetCDF file for that point ONLY when the simulation NSTEP matches
# the point's target timestep.
#
# Config (plume-config-ifs-t159-timestep-test.json):
#   points  1-4   timestep=1
#   points  5-8   timestep=2
#   points  9-12  timestep=5
#
# The driver is run for 6 steps.  Expected outcome:
#   each point has output ONLY at its configured timestep.

set -eux

srcdir=@CMAKE_CURRENT_SOURCE_DIR@
bindir=@CMAKE_CURRENT_BINARY_DIR@

input_data_dir=@TEST_DATA_DIR@/input_files_t159
exedir=@CMAKE_BINARY_DIR@/bin
configs_dir=@CMAKE_BINARY_DIR@/tests/plugin_configs

tmpdir_tests=@CMAKE_BINARY_DIR@/tests/tmpdir_scm_plugin_timestep

if [[ ! -e $tmpdir_tests ]]; then
    mkdir -p $tmpdir_tests
else
    echo "Directory $tmpdir_tests already exists. Cleaning output files.."
    rm -f ${tmpdir_tests}/scm_in_proc_00001_pt_*
fi

cd $tmpdir_tests

# Symlinks to input data (reuse t159 GRIB files)
[[ ! -e cld_grib   ]] && ln -s $input_data_dir/cld_grib_t159   cld_grib
[[ ! -e sfc_grib   ]] && ln -s $input_data_dir/sfc_grib_t159   sfc_grib
[[ ! -e spec_grib  ]] && ln -s $input_data_dir/spec_grib_t159  spec_grib
[[ ! -e namelist_1c ]] && ln -s $input_data_dir/namelist_1c_t159 namelist_1c

export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-""}:@CMAKE_BINARY_DIR@/lib
export PLUME_CONFIG_FILE=$configs_dir/plume-config-ifs-t159-timestep-test.json
export PLUME_SCM_PLUGIN_VERT_TABLES_TEST_NAMELIST=./namelist_1c

# Run the driver for 6 steps (steps 1 .. 6)
export SCM_PLUGIN_TESTER_N_STEPS=6
$exedir/scm_plugin_tester


# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

check_exists() {
    local f="$1"
    if [[ ! -f "$f" ]]; then
        echo "FAIL: expected output file not found: $f"
        exit 1
    fi
    echo "OK:   expected file present:  $f"
}

check_absent() {
    local f="$1"
    if [[ -f "$f" ]]; then
        echo "FAIL: unexpected output file found: $f"
        exit 1
    fi
    echo "OK:   file correctly absent:  $f"
}

proc=00001

# Point definitions from plume-config-ifs-t159-timestep-test.json
# Format: "point_id:lat:lon:timestep"
point_defs=(
    "1:51.61:-0.81:1"
    "2:51.14:-1.44:1"
    "3:51.62:-1.08:1"
    "4:52.5:-1.0:1"
    "5:50.92:-0.47:2"
    "6:54.2:-1.3:2"
    "7:52.5:-3.0:2"
    "8:53.0:-1.0:2"
    "9:52.2:0.4:5"
    "10:51.0:-2.6:5"
    "11:51.97:4.92:5"
    "12:36.37:-97.3:5"
)

for pdef in "${point_defs[@]}"; do
    IFS=':' read -r pid plat plon pstep <<< "$pdef"
    pid_5d=$(printf "%05d" "$pid")

    echo "Checking point ${pid} (lat=${plat}, lon=${plon}, timestep=${pstep})"

    for s in 1 2 3 4 5 6; do
        s_5d=$(printf "%05d" "$s")
        f="scm_in_proc_${proc}_pt_${pid_5d}_step_${s_5d}.nc"
        if [[ "$s" -eq "$pstep" ]]; then
            check_exists "$f"
        else
            check_absent "$f"
        fi
    done
done

echo "All per-point timestep-filter checks passed."
