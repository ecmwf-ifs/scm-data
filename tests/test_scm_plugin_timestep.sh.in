# Test: per-point timestep filtering in the SCM plugin
#
# Each point in the config carries a "timesteps" list of ints.  The plugin
# must write an output NetCDF file for that point ONLY at the simulation
# steps that appear in its list.  append_output=0, so a distinct file is
# produced per (point, matching-step) pair.
#
# Config (plume-config-ifs-t159-timestep-test.json):
#   point 1  timesteps=[1, 3, 5]
#   point 2  timesteps=[2, 4, 6]
#   point 3  timesteps=[1, 2, 3]
#   point 4  timesteps=[4, 5, 6]
#   point 5  timesteps=[1, 2, 3, 4, 5, 6]
#
# The driver is run for 6 steps.  Expected outcome:
#   each point has output files ONLY at its configured timesteps.
#
# The driver is additionally fed a step sequence with repeated NSTEP values
# ("1,2,3,3,3,4,5,5,5,5,6,6,6", 13 entries in total). Whether the plugin
# actually re-executes for a repeated NSTEP depends on the SCM_PLUME_PLUGIN_UNIQUE_STEPS
# build option (WITH_SCM_PLUME_PLUGIN_UNIQUE_STEPS):
#   - ON  (default): the plugin skips a step if NSTEP == previous NSTEP,
#         so it executes exactly once per unique step -> 6 executions.
#   - OFF: the plugin executes for every entry in the sequence, including
#         repeated steps -> 13 executions.
# This is verified by counting the "SCM-PLUGIN executing step.." log lines.

set -euxo pipefail

# Set by cmake from the SCM_PLUME_PLUGIN_UNIQUE_STEPS feature (ON/OFF)
have_unique_steps="@HAVE_SCM_PLUME_PLUGIN_UNIQUE_STEPS@"

srcdir=@CMAKE_CURRENT_SOURCE_DIR@
bindir=@CMAKE_CURRENT_BINARY_DIR@

input_data_dir=@TEST_DATA_DIR@/input_files_t159
exedir=@CMAKE_BINARY_DIR@/bin
configs_dir=@CMAKE_BINARY_DIR@/tests/plugin_configs

tmpdir_tests=@CMAKE_BINARY_DIR@/tests/tmpdir_scm_plugin_timestep

if [[ ! -e $tmpdir_tests ]]; then
    mkdir -p $tmpdir_tests
else
    echo "Directory $tmpdir_tests already exists. Cleaning output files.."
    rm -f ${tmpdir_tests}/scm_in_proc_00001_pt_*
fi

cd $tmpdir_tests

# Symlinks to input data (reuse t159 GRIB files)
[[ ! -e cld_grib   ]] && ln -s $input_data_dir/cld_grib_t159   cld_grib
[[ ! -e sfc_grib   ]] && ln -s $input_data_dir/sfc_grib_t159   sfc_grib
[[ ! -e spec_grib  ]] && ln -s $input_data_dir/spec_grib_t159  spec_grib
[[ ! -e namelist_1c ]] && ln -s $input_data_dir/namelist_1c_t159 namelist_1c

export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-""}:@CMAKE_BINARY_DIR@/lib
export PLUME_CONFIG_FILE=$configs_dir/plume-config-ifs-t159-timestep-test.json
export PLUME_SCM_PLUGIN_VERT_TABLES_TEST_NAMELIST=./namelist_1c

# Run the driver for 6 steps (steps 1 .. 6)
# export SCM_PLUGIN_TESTER_N_STEPS=6

# test with duplicated steps (skipped only if SCM_PLUME_PLUGIN_UNIQUE_STEPS is ON)
export SCM_PLUGIN_TESTER_STEPS="1,2,3,3,3,4,5,5,5,5,6,6,6"
runlog=$tmpdir_tests/scm_plugin_tester.log
$exedir/scm_plugin_tester 2>&1 | tee "$runlog"

# Number of times the plugin actually executed the step logic
n_executions=$(grep -c "SCM-PLUGIN executing step.." "$runlog")

if [[ "$have_unique_steps" == "1" ]]; then
    expected_executions=6
else
    expected_executions=13
fi

if [[ "$n_executions" -ne "$expected_executions" ]]; then
    echo "FAIL: expected $expected_executions plugin executions (SCM_PLUME_PLUGIN_UNIQUE_STEPS=$have_unique_steps), got $n_executions"
    exit 1
fi
echo "OK:   plugin executed $n_executions times as expected (SCM_PLUME_PLUGIN_UNIQUE_STEPS=$have_unique_steps)"


# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

check_exists() {
    local f="$1"
    if [[ ! -f "$f" ]]; then
        echo "FAIL: expected output file not found: $f"
        exit 1
    fi
    echo "OK:   expected file present:  $f"
}

check_absent() {
    local f="$1"
    if [[ -f "$f" ]]; then
        echo "FAIL: unexpected output file found: $f"
        exit 1
    fi
    echo "OK:   file correctly absent:  $f"
}

proc=00001

# Point definitions from plume-config-ifs-t159-timestep-test.json
# Format: "point_id:comma_separated_timesteps"
point_defs=(
    "1:1,3,5"
    "2:2,4,6"
    "3:1,2,3"
    "4:4,5,6"
    "5:1,2,3,4,5,6"
)

for pdef in "${point_defs[@]}"; do
    IFS=':' read -r pid psteps <<< "$pdef"
    pid_5d=$(printf "%05d" "$pid")

    echo "Checking point ${pid} (timesteps=${psteps})"

    for s in 1 2 3 4 5 6; do
        s_5d=$(printf "%05d" "$s")
        f="scm_in_proc_${proc}_pt_${pid_5d}_step_${s_5d}.nc"
        # match `s` against the comma-separated list psteps
        if [[ ",${psteps}," == *",${s},"* ]]; then
            check_exists "$f"
        else
            check_absent "$f"
        fi
    done
done

echo "All per-point timestep-filter checks passed."
