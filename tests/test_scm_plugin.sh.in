#!/usr/bin/env bash

set -eux

srcdir=@CMAKE_CURRENT_SOURCE_DIR@
bindir=@CMAKE_CURRENT_BINARY_DIR@
datadir=@CMAKE_BINARY_DIR@/tests/data
exedir=@CMAKE_BINARY_DIR@/bin


tmpdir_tests=@CMAKE_BINARY_DIR@/tests/tmpdir_scm_plugin
if [[ ! -e $tmpdir_tests ]]; then
    mkdir $tmpdir_tests
else
    echo "Directory $tmpdir_tests already exists. Cleaning.."
    rm -rf ${tmpdir_tests}/scm_in_proc_00001_pt*
fi

cd $tmpdir_tests

if [[ ! -e cld_grib ]]; then
    ln -s $datadir/cld_grib_t159 cld_grib
else
    echo "Link cld_grib already exists, not creating.."
fi

if [[ ! -e sfc_grib ]]; then
    ln -s $datadir/sfc_grib_t159 sfc_grib
else
    echo "Link sfc_grib already exists, not creating.."
fi

if [[ ! -e spec_grib ]]; then
    ln -s $datadir/spec_grib_t159 spec_grib
else
    echo "Link spec_grib already exists, not creating.."
fi

if [[ ! -e namelist_1c ]]; then
    ln -s $datadir/namelist_1c_t159 namelist_1c
else
    echo "Link namelist_1c already exists, not creating.."
fi


configs_dir=@CMAKE_BINARY_DIR@/tests/plugin_configs

export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-""}:@CMAKE_BINARY_DIR@/lib
export PLUME_CONFIG_FILE=$configs_dir/plume-config-ifs-t159.json

# Run the scm-data plugin driver
$exedir/scm_plugin_tester


# Compare NetCDF files against reference files
for out_file_id in $(seq 1 1 12); do

    out_file_id_2d=$(printf "%02d" $out_file_id)

    ref_file=${datadir}/reference/scm_in_0001_${out_file_id_2d}.nc
    out_file=${tmpdir_tests}/scm_in_proc_00001_pt_000${out_file_id_2d}_step_00999.nc

    $exedir/scm_compare ${ref_file} ${out_file} 1.0E-8
done